{
  "name": "ledger-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ledger: Standalone accounting software for everyday use. REST API: Express 5 + TypeScript + MongoDB, double-entry-safe decimal money, Firebase ID-token auth.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "seed": "tsx scripts/seed-user.ts",
    "integrity": "tsx scripts/integrity-check.ts",
    "drop-stale-indexes": "tsx scripts/drop-stale-indexes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "typescript": "^5.9.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "eslint": "^9.37.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
