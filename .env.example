# ── Ledger API — environment template ────────────────────────────────────────
# Copy to .env for local development. On Vercel/Render, set these in the
# dashboard instead — never commit a real value.

# Runtime mode: development | test | production
NODE_ENV=development

# Local port for the Express server (Vercel ignores this; it injects its own)
PORT=4000

# CORS allowlist — comma-separated exact origins, no trailing slash.
# Add every deployment origin: local, production frontend, preview URLs.
FRONTEND_URL=http://localhost:3000

# MongoDB connection string (Atlas or local). REQUIRED.
MONGODB_URI=

# Database name the collections live in
MONGODB_DB=personal_ledger

# Firebase project whose ID tokens this API accepts. REQUIRED.
# No service-account private key is needed — tokens are verified against
# Google's published public keys.
FIREBASE_PROJECT_ID=

# ── Receipt OCR (optional) ───────────────────────────────────────────────────
# With a key present, /api/v1/receipts/extract reads receipts with that
# provider. Without one, the endpoint reports itself unavailable and the app
# falls back to manual entry — degraded, not broken.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
